<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    style="@style/CoordinatorDefaultStyle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <digital.euforia.app.ui.subscription.LockableScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/scrollLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/topLayout"
                android:layout_width="match_parent"
                android:layout_height="700dp"
                android:layout_marginBottom="20dp">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="100dp"
                    app:use_controller="false" />

                <ImageView
                    android:id="@+id/imageFallback"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="100dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:src="@drawable/img_premium_bg"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gradient_subscription_101"
                        android:orientation="vertical"
                        android:paddingTop="150dp"
                        tools:ignore="UselessParent">

                        <TextView
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:layout_marginBottom="11dp"
                            android:fontFamily="@font/inter_regular"
                            android:gravity="center_horizontal"
                            android:includeFontPadding="false"
                            android:maxLines="7"
                            android:text="@string/subscription_title"
                            android:textColor="@color/colorWhite"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="24sp"
                            app:autoSizeMinTextSize="16sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:id="@+id/getPremiumTop"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginStart="36dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="36dp"
                            android:background="@drawable/background_button_accent"
                            android:elevation="8dp"
                            android:fontFamily="@font/inter_regular"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/get_started"
                            android:textColor="@color/colorWhite"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/primaryButtonSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="24dp"
                            android:elevation="0dp"
                            android:gravity="center_horizontal"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textAllCaps="true"
                            android:textColor="@color/colorIntroTerms"
                            android:textSize="11sp"
                            app:autoSizeMaxTextSize="12sp"
                            app:autoSizeMinTextSize="9sp"
                            app:autoSizeTextType="uniform"
                            tools:text="Try 7 days for free, then 29,99 USD" />

                        <ImageView
                            android:id="@+id/more"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:contentDescription="@string/more"
                            android:padding="5dp"
                            android:rotation="90"
                            android:src="@drawable/ic_right_chevron" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/benefitsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textAllCaps="true"
                android:textColor="@color/colorDarkLight"
                android:textSize="12sp"
                android:visibility="invisible"
                tools:text="Users most often listen to this" />

            <TextView
                android:id="@+id/benefitsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:textColor="@color/colorWhite"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Benefits" />

            <LinearLayout
                android:id="@+id/benefits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="46dp"
                android:orientation="vertical"
                tools:layout_height="300dp" />

            <TextView
                android:id="@+id/reviewsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textAllCaps="true"
                android:textColor="@color/colorDarkLight"
                android:textSize="12sp"
                tools:text="Users most often listen to this" />

            <TextView
                android:id="@+id/reviewsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:textColor="@color/colorWhite"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Reviews" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="44dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:layout_height="300dp" />

            <TextView
                android:id="@+id/plansSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textAllCaps="true"
                android:textColor="@color/colorDarkLight"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Users most often listen to this" />

            <TextView
                android:id="@+id/plansTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:textColor="@color/colorWhite"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Plans" />

            <FrameLayout
                android:id="@+id/planYearCardGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/planYearCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:cardBackgroundColor="@color/colorEmpty"
                    app:cardCornerRadius="12dp">

                    <RelativeLayout
                        android:id="@+id/planYearLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="24dp"
                        android:paddingBottom="24dp">

                        <TextView
                            android:id="@+id/planYearTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignTop="@+id/planYearButton"
                            android:layout_alignBottom="@+id/planYearButton"
                            android:layout_alignParentStart="true"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="12dp"
                            android:layout_toStartOf="@+id/planYearButton"
                            android:fontFamily="@font/inter_regular"
                            android:gravity="start|center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/colorWhite"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="22sp"
                            app:autoSizeMinTextSize="16sp"
                            app:autoSizeTextType="uniform"
                            tools:text="$34.99/year" />

                        <TextView
                            android:id="@+id/planYearButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/background_button_accent"
                            android:elevation="8dp"
                            android:fontFamily="@font/inter_regular"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxWidth="150dp"
                            android:maxLines="1"
                            android:minWidth="96dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/subscription_button_title"
                            android:textColor="@color/colorWhite"
                            android:textSize="16sp"
                            app:autoSizeMaxTextSize="16sp"
                            app:autoSizeMinTextSize="13sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:id="@+id/planYearSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/planYearTitle"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="13dp"
                            android:layout_marginEnd="14dp"
                            android:layout_toStartOf="@+id/planYearButtonOffer"
                            android:elevation="0dp"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textAllCaps="true"
                            android:textColor="@color/colorGrey"
                            android:textSize="11sp"
                            app:autoSizeMaxTextSize="12sp"
                            app:autoSizeMinTextSize="9sp"
                            app:autoSizeTextType="uniform"
                            tools:text="Try 7 days for free" />

                        <TextView
                            android:id="@+id/planYearButtonOffer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/planYearTitle"
                            android:layout_alignStart="@+id/planYearButton"
                            android:layout_alignEnd="@+id/planYearButton"
                            android:layout_marginTop="13dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textAllCaps="true"
                            android:textColor="@color/colorGrey"
                            android:textSize="11sp"
                            app:autoSizeMaxTextSize="12sp"
                            app:autoSizeMinTextSize="9sp"
                            app:autoSizeTextType="uniform"
                            tools:text="$2,99/month" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/planYearLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/background_subscription_white_label"
                    android:elevation="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxWidth="200dp"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingTop="4.5dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4.5dp"
                    android:textColor="@color/colorAccent"
                    android:textSize="16sp"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform"
                    tools:text="$2,99/month" />
            </FrameLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/planMonthCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="40dp"
                app:cardBackgroundColor="@color/colorEmpty"
                app:cardCornerRadius="12dp">

                <RelativeLayout
                    android:id="@+id/planMonthLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/planMonthTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/planMonthButton"
                        android:layout_alignBottom="@+id/planMonthButton"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="12dp"
                        android:layout_toStartOf="@+id/planMonthButton"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="start|center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/colorWhite"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="22sp"
                        app:autoSizeMinTextSize="16sp"
                        app:autoSizeTextType="uniform"
                        tools:text="$34.99/year" />

                    <TextView
                        android:id="@+id/planMonthButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/background_button_accent"
                        android:elevation="8dp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxWidth="150dp"
                        android:maxLines="1"
                        android:minWidth="96dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/subscription_button_title"
                        android:textColor="@color/colorWhite"
                        android:textSize="16sp"
                        app:autoSizeMaxTextSize="16sp"
                        app:autoSizeMinTextSize="13sp"
                        app:autoSizeTextType="uniform" />

                    <TextView
                        android:id="@+id/planMonthSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/planMonthTitle"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="13dp"
                        android:layout_marginEnd="14dp"
                        android:layout_toStartOf="@+id/planMonthButtonOffer"
                        android:elevation="0dp"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textAllCaps="true"
                        android:textColor="@color/colorGrey"
                        android:textSize="11sp"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeTextType="uniform"
                        tools:text="Try 7 days for free" />

                    <TextView
                        android:id="@+id/planMonthButtonOffer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/planMonthTitle"
                        android:layout_alignStart="@+id/planMonthButton"
                        android:layout_alignEnd="@+id/planMonthButton"
                        android:layout_marginTop="13dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textAllCaps="true"
                        android:textColor="@color/colorGrey"
                        android:textSize="11sp"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeTextType="uniform"
                        tools:text="$2,99/month" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/extraSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textAllCaps="true"
                android:textColor="@color/colorDarkLight"
                android:textSize="12sp"
                android:visibility="invisible"
                tools:text="Users most often listen to this" />

            <TextView
                android:id="@+id/extraTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:textColor="@color/colorWhite"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Extra" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="32dp"
                android:orientation="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:layout_height="300dp" />

            <TextView
                android:id="@+id/titleBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="11dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:text="@string/subscription_title"
                android:textColor="@color/colorWhite"
                android:textSize="20sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="24sp"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/getPremiumBottom"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="36dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="36dp"
                android:background="@drawable/background_button_accent"
                android:elevation="8dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/subscription_button_title"
                android:textColor="@color/colorWhite"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bottomButtonSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="16dp"
                android:elevation="0dp"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/colorIntroTerms"
                android:textSize="11sp"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeTextType="uniform"
                tools:text="Try 7 days for free, then 29,99 USD" />

            <TextView
                android:id="@+id/terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/premium_terms_text_small"
                android:textColor="@color/colorIntroTerms"
                android:textSize="12sp"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>
    </digital.euforia.app.ui.subscription.LockableScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/gradient_viewer_top"
        android:elevation="0dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:alpha="0.75"
        android:background="@drawable/gradient_viewer_top"
        android:elevation="0dp" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:theme="@style/AppBarOverlay"
        app:elevation="0dp">

        <View
            android:id="@+id/statusBarOffsetView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_height"
            app:layout_scrollFlags="noScroll" />

        <FrameLayout
            android:id="@+id/topBarLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:elevation="12dp"
            app:layout_scrollFlags="noScroll">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center"
                android:layout_margin="12dp"
                android:alpha="0.85"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:scaleX="0.9"
                android:scaleY="0.9"
                android:src="@drawable/ic_close"
                app:tint="@color/colorWhite" />

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="@color/colorAccent"
                app:cardCornerRadius="15dp"
                app:cardElevation="8dp">

                <TextView
                    android:id="@+id/subscribe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackground"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/subscription_button_title"
                    android:textColor="@color/colorWhite"
                    android:textSize="13sp" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/view_progress" />

    <include layout="@layout/view_subscription_processing" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>