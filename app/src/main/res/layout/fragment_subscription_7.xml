<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    style="@style/CoordinatorDefaultStyle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_subscription_8_bg">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <digital.euforia.app.ui.subscription.AspectRatioPlayerView
                android:id="@+id/video"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:ratio="0.5"
                app:use_controller="false" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="11dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="start"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:text="@string/subscription_title"
                android:textColor="#E6FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="24sp"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeTextType="uniform" />

            <LinearLayout
                android:id="@+id/items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="300dp" />
        </LinearLayout>

    </ScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/subscribeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:alpha="0"
        app:cardCornerRadius="12dp"
        tools:alpha="1">

        <LinearLayout
            android:id="@+id/subscribeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000139"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="16dp">

                <RelativeLayout
                    android:id="@+id/annual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/background_period_subscription_7"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/titleYearly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="5dp"
                        android:alpha="0.95"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/subscription_title_yearly"
                        android:textColor="@color/colorWhite"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/label1Yearly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/titleYearly"
                        android:layout_alignParentStart="true"
                        android:layout_gravity="center"
                        android:layout_marginBottom="16dp"
                        android:layout_toStartOf="@+id/priceYearly"
                        android:alpha="0.95"
                        android:ellipsize="marquee"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/colorWhite"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeTextType="uniform"
                        tools:text="Offer string" />

                    <TextView
                        android:id="@+id/priceYearly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        android:alpha="1"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/colorWhite"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="UAH 1199/month" />
                </RelativeLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="@color/colorAccent"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:id="@+id/label2Yearly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="4dp"
                        android:elevation="8dp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/colorWhite"
                        android:textSize="14sp"
                        tools:text="7-day Free Trial" />
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/monthly"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/background_period_subscription_7"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/titleMonthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:alpha="0.95"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/subscription_title_monthly"
                    android:textColor="@color/colorWhite"
                    android:textSize="15sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minWidth="8dp" />

                <TextView
                    android:id="@+id/priceMonthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:alpha="1"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/colorWhite"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="UAH 129.99/month" />
            </LinearLayout>

            <TextView
                android:id="@+id/getPremium"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/background_button_white"
                android:elevation="8dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/get_started"
                android:textColor="@color/colorBlack"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="22dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/premium_terms_text_small"
                android:textColor="@color/colorIntroTerms"
                android:textSize="11sp"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@drawable/gradient_viewer_top" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:theme="@style/AppBarOverlay"
        app:elevation="0dp">

        <View
            android:id="@+id/statusBarOffsetView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_height"
            app:layout_scrollFlags="noScroll" />

        <FrameLayout
            android:id="@+id/topBarLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:layout_scrollFlags="noScroll">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|top"
                android:layout_margin="12dp"
                android:alpha="0.85"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:scaleX="0.9"
                android:scaleY="0.9"
                android:src="@drawable/ic_close"
                app:tint="@color/colorWhite" />
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/view_progress" />

    <include layout="@layout/view_subscription_processing" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>